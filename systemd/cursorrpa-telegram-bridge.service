[Unit]
Description=CursorRPA Telegram Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/shectory/workspaces/CursorRPA/services/telegram-bridge
EnvironmentFile=/home/shectory/workspaces/CursorRPA/services/telegram-bridge/.env
ExecStart=/home/shectory/workspaces/CursorRPA/services/telegram-bridge/.venv/bin/python bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
